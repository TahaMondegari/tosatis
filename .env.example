# BoxAPI (OpenAI-compatible) — required for the AI agent; without it a rule-based assistant is used
BOXAPI_API_KEY=
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
LLM_FALLBACK_MODEL=gpt-5.4-mini
LLM_ROUTER_MODEL=gpt-5.4-mini
LLM_RETRIES=2
LLM_TIMEOUT_MS=45000
PORT=3000

# Map (build-time, read by the web app). Leave empty to use the built-in sketch map (no network).
# VITE_MAP_PROVIDER = carto | osm (free, no key) · maptiler | stadia (foreign, free tier + paid) · mapir (Iranian, key) · custom
# Keys: MapTiler https://cloud.maptiler.com · Stadia https://client.stadiamaps.com · Map.ir https://corp.map.ir · Neshan (SDK) https://platform.neshan.org
VITE_MAP_PROVIDER=
VITE_MAP_KEY=
# For custom: any XYZ raster template, e.g. https://tiles.example.com/{theme}/{z}/{x}/{y}.png?key={key}
VITE_MAP_TILE_URL=

# ── AI phone calls to shops (Poshtyar) — optional, UI appears only when enabled ─────────────
# 1) In the Poshtyar panel create an operator → POSHTYAR_OPERATOR_ID, and an API key (live) → POSHTYAR_API_KEY.
# 2) Tools & Webhooks → new tool:
#      name: report_shop_answer   method: POST   URL: https://<your-domain>/api/poshtyar/webhook
#      header: X-Webhook-Token: <same as POSHTYAR_WEBHOOK_TOKEN>
#      parameters: request_id (string, required), available (yes|no|unknown), price (number), hours, installment, notes (strings)
#    and attach it to the operator.
# 3) POSHTYAR_ENABLED=true. Use POSHTYAR_TEST_PHONE to route every call to your own phone (dataset numbers are fake).
POSHTYAR_ENABLED=false
POSHTYAR_MOCK=false
POSHTYAR_API_KEY=
POSHTYAR_OPERATOR_ID=
POSHTYAR_WEBHOOK_TOKEN=
POSHTYAR_RETRY_POLICY=300,1800
POSHTYAR_TIMEOUT_MIN=6
POSHTYAR_TEST_PHONE=
